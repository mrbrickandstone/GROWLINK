{
  "functions": {
    "api/data.js": { "maxDuration": 30 },
    "api/monitor.js": { "maxDuration": 60 }
  },
  "headers": [{
    "source": "/(.*)",
    "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "X-Frame-Options", "value": "DENY" }
    ]
  }],
  "crons": [{ "path": "/api/monitor", "schedule": "*/5 * * * *" }]
}
