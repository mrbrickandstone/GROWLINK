[Unit]
Description=Farber verified control-data backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=farber
Group=farber
WorkingDirectory=/opt/farber
ExecStart=/usr/bin/node /opt/farber/security/backup-schedule.cjs run /etc/farber/backup-schedule.json
TimeoutStartSec=960
TimeoutStopSec=30
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/farber
