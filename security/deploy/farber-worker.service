[Unit]
Description=Farber durable archive worker
After=network-online.target
Wants=network-online.target

[Service]
User=farber
Group=farber
WorkingDirectory=/opt/farber
EnvironmentFile=/etc/farber/worker.env
ExecStart=/usr/bin/node /opt/farber/security/worker.cjs
Restart=always
RestartSec=5
TimeoutStopSec=330
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/farber

[Install]
WantedBy=multi-user.target
